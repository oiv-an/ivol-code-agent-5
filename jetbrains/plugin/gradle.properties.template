# Plugin basic information
pluginGroup=pro.ivol.kilocode5.jetbrains
pluginVersion={{VERSION}}

# Platform basic information
platformVersion=2026.2.1
platformType=PS
pluginSinceBuild=262
pluginUntilBuild=262.*
javaVersion=25

# The PhpStorm 2026.2 API surface is large enough that Kotlin's default
# compiler heap can run out during a clean build.
org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
kotlin.daemon.jvmargs=-Xmx2048m

# Disable automatic Kotlin stdlib dependency to avoid conflicts with IntelliJ Platform's bundled version
# See: https://jb.gg/intellij-platform-kotlin-stdlib
kotlin.stdlib.default.dependency=false

# Other project configurations can be added here
vscodeVersion=1.100.0
